# Copy this file to .env and adjust as needed.
# .env must never be committed to git.

# --- Application ---
DEBUG=True

# --- Weather provider (Phase 2) ---
# Open-Meteo needs no API key for non-commercial use.
WEATHER_PROVIDER=open-meteo
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_SECONDS=10
# "auto" resolves local time from the coordinates, so daily aggregates
# follow local calendar days rather than UTC days.
WEATHER_TIMEZONE=auto
WEATHER_FORECAST_MAX_DAYS=5

# --- Machine learning (Phase 13) ---
MODEL_PATH=ml/models

# --- Database (left empty until PostgreSQL/PostGIS is introduced) ---
DATABASE_URL=

# --- CORS: comma-separated list of allowed browser origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
