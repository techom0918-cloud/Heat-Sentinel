# Copy this file to .env and adjust as needed.
# .env must never be committed to git.

# --- Application ---
DEBUG=True

# --- Weather provider (Phase 2) ---
# Open-Meteo needs no API key for non-commercial use.
WEATHER_PROVIDER=open-meteo
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_SECONDS=10
# "auto" resolves local time from the coordinates, so daily aggregates
# follow local calendar days rather than UTC days.
WEATHER_TIMEZONE=auto
WEATHER_FORECAST_MAX_DAYS=5

# --- Thermal stress engine (Phase 3) ---
# Heat Index category edges in Celsius, matching heat_pipeline.py.
# PROTOTYPE bands, not a medical classification.
HEAT_INDEX_BOUNDS_C=27,32,41,54
HEAT_INDEX_CATEGORIES=LOW,MODERATE,HIGH,VERY_HIGH,EXTREME
# UTCI model applicability limits - do not widen without justification.
UTCI_WIND_MIN_MS=0.5
UTCI_WIND_MAX_MS=17.0
UTCI_TEMP_MIN_C=-50.0
UTCI_TEMP_MAX_C=50.0

# --- Vulnerability engine (Phase 4) ---
# PROTOTYPE WEIGHTS - not medically validated. Must sum to 1.0.
VULNERABILITY_WEIGHT_ELDERLY=0.20
VULNERABILITY_WEIGHT_OUTDOOR_WORKERS=0.20
VULNERABILITY_WEIGHT_POPULATION_DENSITY=0.15
VULNERABILITY_WEIGHT_HEALTHCARE_ACCESS=0.15
VULNERABILITY_WEIGHT_HISTORICAL_EXPOSURE=0.15
VULNERABILITY_WEIGHT_HISTORICAL_MORTALITY=0.15
# Density normalisation: "log" or "linear". Floor/ceiling are prototype
# anchors in people per km^2 - replace with real census extremes.
POPULATION_DENSITY_NORMALISATION=log
POPULATION_DENSITY_FLOOR=10
POPULATION_DENSITY_CEILING=20000
# PROTOTYPE category edges.
VULNERABILITY_BOUNDS=0.25,0.50,0.75
VULNERABILITY_CATEGORIES=LOW,MODERATE,HIGH,EXTREME

# --- Health risk engine (Phase 5) ---
# PROTOTYPE WEIGHTS - not medically validated. Each group must sum to 1.0.
RISK_WEIGHT_THERMAL=0.65
RISK_WEIGHT_VULNERABILITY=0.35
RISK_THERMAL_WEIGHT_HEAT_INDEX=0.30
RISK_THERMAL_WEIGHT_WBGT=0.35
RISK_THERMAL_WEIGHT_UTCI=0.35
# Normalisation anchors, degrees Celsius.
# Heat Index: reuses the Phase 3 category edges.
RISK_HEAT_INDEX_MIN_C=27
RISK_HEAT_INDEX_MAX_C=54
# WBGT: PROTOTYPE ANCHORS, UNCALIBRATED. ISO 7243 / ACGIH limits apply to
# outdoor WBGT, not the shade approximation, so they are not used here.
RISK_WBGT_MIN_C=22
RISK_WBGT_MAX_C=35
# UTCI: published UTCI stress assessment scale (Brode et al. 2012).
RISK_UTCI_MIN_C=26
RISK_UTCI_MAX_C=46
# PROTOTYPE category edges.
RISK_BOUNDS=0.25,0.50,0.75
RISK_CATEGORIES=LOW,MODERATE,HIGH,EXTREME

# --- Trained model integration ---
# Paths are relative to backend/ unless absolute.
ML_MODEL_PATH=../ml/heat_model.joblib
ML_PIPELINE_PATH=../ml/heat_pipeline.py
# Hourly history fetched per forecast. The model needs 14+ complete days.
ML_HISTORY_DAYS=35

# --- Machine learning (Phase 13) ---
MODEL_PATH=ml/models

# --- Database (left empty until PostgreSQL/PostGIS is introduced) ---
DATABASE_URL=

# --- CORS: comma-separated list of allowed browser origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
